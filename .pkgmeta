# Packaging for the BigWigs packager (used by .github/workflows/release.yml) and
# tools/package.py. The libraries are committed in Libs/, so there are no externals.
package-as: Circlet

manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown

ignore:
  - tests
  - tools
  - docs
  - .github
  - .gitignore
  - .pkgmeta
